{
  "name": "knoa-mobile",
  "version": "0.2.73",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "bundle:android": "EXPO_NO_TELEMETRY=1 expo export --platform android --output-dir /tmp/knoa-mobile-export",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "contract": "python ../../scripts/export_gateway_openapi.py && openapi-typescript openapi.json -o src/api/schema.ts",
    "doctor": "EXPO_NO_TELEMETRY=1 expo-doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.3.0",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.12",
    "expo-audio": "^57.0.3",
    "expo-camera": "57.0.3",
    "expo-constants": "~57.0.12",
    "expo-crypto": "57.0.1",
    "expo-document-picker": "57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "^57.0.10",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-media-library": "~57.0.4",
    "expo-router": "~57.0.14",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "~57.0.13",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-marked": "^8.1.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "expo-doctor": "^1.20.1",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
