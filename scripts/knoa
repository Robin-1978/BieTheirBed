#!/usr/bin/env bash
# Run Knoa directly from this development checkout without installing a wheel.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    KNOA_DEV_PYTHON="$REPO_ROOT/.venv/bin/python"
elif [ -x "/disk/miniconda3/bin/python" ]; then
    KNOA_DEV_PYTHON="/disk/miniconda3/bin/python"
else
    KNOA_DEV_PYTHON="$(command -v python3 2>/dev/null || true)"
fi

if [ -z "$KNOA_DEV_PYTHON" ] || [ ! -x "$KNOA_DEV_PYTHON" ]; then
    echo "ERROR: no usable Python interpreter found." >&2
    exit 1
fi

export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$KNOA_DEV_PYTHON" -m knoa_platform "$@"
