{
  "expo": {
    "name": "小诺",
    "slug": "knoa-mobile",
    "scheme": "knoa",
    "version": "0.2.149",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../../assets/branding/xiaonuo-avatar-tech.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.knoa.mobile",
      "infoPlist": {
        "NSBonjourServices": [
          "_knoa-node._tcp."
        ],
        "NSLocalNetworkUsageDescription": "允许小诺发现同一局域网内已配对的 Node，以优先建立局域网直连。",
        "NSLocationWhenInUseUsageDescription": "允许小诺在你发送消息时附带当前位置，以便按你所在城市回答天气、附近等提问。关闭后则只用记住的地址。"
      }
    },
    "android": {
      "package": "dev.knoa.mobile",
      "versionCode": 160,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../../assets/branding/xiaonuo-avatar-tech.png",
        "backgroundColor": "#F4F0E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许小诺在你发送消息时附带当前位置，以便按你所在城市回答天气、附近等提问。"
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-media-library",
        {
          "photosPermission": "允许小诺读取你选择的照片",
          "savePhotosPermission": "允许小诺把图片保存到手机相册"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许小诺录音并交给已配置的语音转写能力"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许小诺扫描本地服务生成的配对二维码"
        }
      ],
      "expo-sharing"
    ]
  }
}
