{
  "expo": {
    "name": "小诺",
    "slug": "knoa-mobile",
    "scheme": "knoa",
    "version": "0.1.8",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "../../assets/branding/xiaonuo-avatar-tech.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.knoa.mobile"
    },
    "android": {
      "package": "dev.knoa.mobile",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../../assets/branding/xiaonuo-avatar-tech.png",
        "backgroundColor": "#F4F0E8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "允许小诺录音并交给已配置的语音转写能力"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许小诺扫描本地服务生成的配对二维码"
        }
      ]
    ]
  }
}
