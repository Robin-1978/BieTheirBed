[Unit]
Description=Cloudflare Tunnel (Knoa Secure Gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/disk/dev/bin/cloudflared tunnel run --token-file /home/robin/.knoa/config/cloudflare.token
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
