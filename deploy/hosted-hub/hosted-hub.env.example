# Hosted Hub local administration bootstrap credential.
# Replace this value with at least 32 random characters and keep the installed
# file readable only by its owner (mode 0600).
KNOA_HUB_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token-at-least-32-characters
KNOA_HUB_PUBLIC_URL=https://knoa.example.com
KNOA_HUB_ADMIN_ENDPOINT=http://127.0.0.1:9529
