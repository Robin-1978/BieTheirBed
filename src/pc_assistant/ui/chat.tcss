/* Chat TUI stylesheet -- uses CSS variables injected by CoreChatApp */

CoreChatApp {
    background: $bg;
}

/* ── Chat log ───────────────────────────────────────── */

#chat-log {
    padding: 0 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: $surface1;
    scrollbar-color-hover: $surface2;
    scrollbar-color-active: $primary;
}

/* ── User message ───────────────────────────────────── */

UserMessage {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: thick $user;
    background: $surface0;
}

UserMessage .label {
    color: $user;
    text-style: bold;
}

UserMessage .body {
    color: $text;
}

/* ── Assistant message ──────────────────────────────── */

AssistantMessage {
    margin: 1 0 0 0;
    padding: 0 1;
    border-left: thick $primary;
}

AssistantMessage .label {
    color: $primary;
    text-style: bold;
}

/* ── Thinking panel ─────────────────────────────────── */

ThinkingPanel {
    color: $muted;
    margin: 0;
    padding: 0 1;
    height: auto;
    max-height: 8;
}

ThinkingPanel CollapsibleTitle {
    color: $think;
    padding: 0;
}

ThinkingPanel #thinking-text {
    color: $muted;
    text-style: italic;
}

/* ── Tool call panel ────────────────────────────────── */

ToolCallPanel {
    margin: 0;
    padding: 0 1;
    height: auto;
}

ToolCallPanel .tool-header {
    color: $tool;
    text-style: bold;
}

ToolCallPanel .tool-result-ok {
    color: $success;
}

ToolCallPanel .tool-result-err {
    color: $error;
}

ToolCallPanel .tool-blocked {
    color: $warning;
}

/* ── Bottom bar ─────────────────────────────────────── */

#bottom-bar {
    dock: bottom;
    height: auto;
    max-height: 10;
}

#user-input {
    height: auto;
    min-height: 1;
    max-height: 6;
    border: tall $surface1;
    background: $surface0;
    color: $text;
}

#user-input:focus {
    border: tall $primary;
}

#status-bar {
    height: 1;
    background: $mantle;
    color: $muted;
    padding: 0 1;
}

/* ── Markdown inside assistant messages ─────────────── */

AssistantMessage Markdown {
    margin: 0;
    padding: 0;
}

AssistantMessage MarkdownH1 {
    color: $primary;
    text-style: bold;
    margin: 1 0 0 0;
}

AssistantMessage MarkdownH2 {
    color: $mauve;
    margin: 1 0 0 0;
}

AssistantMessage MarkdownFence {
    margin: 0 0;
    padding: 0 1;
    background: $surface0;
}

/* ── Command output ─────────────────────────────────── */

CommandOutput {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $surface2;
    color: $subtext;
}

CommandOutput Markdown {
    margin: 0;
    padding: 0;
}

/* ── Header ─────────────────────────────────────────── */

Header {
    background: $mantle;
    color: $text;
}
